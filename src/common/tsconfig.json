{
  "extends": "./tsconfig.common.json",
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,

    // Support for node types (used in build scripts)
    "lib": ["esnext"],
    "types": ["node"],

    "paths": {
      "@lofi/common/*": [
        "./*"
      ],
    },
  },
  "include": [
    "scripts/",
    "eslint.config.mjs",
  ]
}
