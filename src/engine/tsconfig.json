{
  "extends": "../common/tsconfig.common.json",
  "references": [
    {
      "path": "../common"
    },
    {
      "path": "../core/tsconfig.build.json"
    },
  ],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@lopoly/common/*": [
        "../common/*"
      ],
      "@lopoly/core/*": [
        "../core/src/*"
      ],
      "@lopoly/engine/*": [
        "./src/*"
      ],
      "@test/*": [
        "./test/*",
      ],
    },
  },
  "include": [
    "src/",
    "scripts/",
    "test/",
    "eslint.config.mjs",
    "vitest.config.ts",
  ]
}