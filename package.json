{
  "name": "@lofi/engine",
  "private": true,
  "version": "0.0.1",
  "description": "LoFi is a 3D game engine built using WebGL with only simple/retro features which makes it very simple to use.",
  "author": "peabnuts123",
  "keywords": [
    "gamedev",
    "game development",
    "game engine",
    "retro",
    "retrogaming"
  ],
  "homepage": "https://github.com/peabnuts123/lofi",
  "bugs": {
    "url": "https://github.com/peabnuts123/lofi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peabnuts123/lofi.git"
  },
  "type": "module",
  "scripts": {
    "start": "vite --host",
    "build": "rm -rf dist && node -r @swc-node/register scripts/build.ts",
    "publish": "node -r @swc-node/register scripts/publish.ts",
    "test": "vitest run",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --coverage && http-server coverage -p 8080",
    "lint": "eslint --max-warnings 0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "checkall": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@swc-node/register": "^1.11.1",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.2",
    "http-server": "^14.1.1",
    "jsdom": "^27.4.0",
    "standardized-audio-context-mock": "^9.7.27",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "fflate": "^0.8.2",
    "online-3d-viewer": "^0.18.0",
    "standardized-audio-context": "^25.3.77"
  },
  "license": "UNLICENSED"
}
