{
  "name": "webgl-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --host",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --coverage && http-server coverage -p 8080",
    "lint": "eslint --max-warnings 0 --no-error-on-unmatched-pattern \"*.{js,mjs,cjs,jsx,mjsx,ts,tsx,mtsx}\" \"src/**/*.{js,mjs,cjs,jsx,mjsx,ts,tsx,mtsx}\" \"test/**/*.{js,mjs,cjs,jsx,mjsx,ts,tsx,mtsx}\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "checkall": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "http-server": "^14.1.1",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "standardized-audio-context-mock": "^9.7.27",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "fflate": "^0.8.2",
    "online-3d-viewer": "^0.18.0",
    "standardized-audio-context": "^25.3.77"
  }
}
